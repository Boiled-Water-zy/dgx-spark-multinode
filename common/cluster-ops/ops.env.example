# cluster-ops 配置示例 —— 双机（master + worker）推理集群的运维层。
# 复制为 ops.env 按你的集群改；安装器把它装到两台 /etc/cluster-ops.env，worker 侧自动改 NODE_ROLE。
# 术语：主节点 master，从节点 worker。下面以 DS4-flash(0731) 双机为例，其它模型改 CONTAINER/PORT/MODEL_ID/LAUNCH 即可。

# --- 身份 ---
# 关键：master↔worker 一切通信走光纤直连 IP（下面 WORKER_RAIL_IP），不依赖管理网 IP。
# 管理网 IP 机器重部署后会变，绝不写进运行期逻辑。WORKER_HOST 仅留作可选、也指向光纤 IP。
NODE_ROLE=master              # master | worker，按节点安装时指定
WORKER_HOST=10.0.0.3          # = WORKER_RAIL_IP（光纤，稳定）
SSH_USER=ai

# --- 光缆直连网段。rail 自动挑“配上地址后 ping 得通对端”的口并实测 GID ---
RAIL_SUBNET=10.0.0
RAIL_PREFIX=24
MASTER_RAIL_IP=10.0.0.2
WORKER_RAIL_IP=10.0.0.3
# 实测 88/67 真连的是 enP2p1s0f0np0（HCA roceP2p1s0f0, GID 3），排最前
RAIL_CANDIDATES="enP2p1s0f0np0 enp1s0f1np1 enp1s0f0np0 enP2p1s0f1np1"

# --- 被监护的推理容器 ---
CONTAINER=ds4-dspark-2x-vllm-dspark-1
PORT=8888
MODEL_ID=deepseek-v4-flash

# --- 有序启动（worker rank1 先、master rank0 后，间隔 < 600s rendezvous）---
# 用实测跑通的按节点 compose 命令，不用会卡的 start 脚本。
DEPLOY_DIR_REMOTE=/home/ai/ds4-dspark-2x
WORKER_LAUNCH="cd /home/ai/ds4-dspark-2x && COMPOSE_DISABLE_ENV_FILE=1 NODE_RANK=1 HEADLESS=1 VLLM_HOST_IP=10.0.0.3 docker compose --env-file .env.dspark -f docker-compose.dspark.yml up -d"
MASTER_LAUNCH="cd /home/ai/ds4-dspark-2x && COMPOSE_DISABLE_ENV_FILE=1 NODE_RANK=0 HEADLESS= VLLM_HOST_IP=10.0.0.2 docker compose --env-file .env.dspark -f docker-compose.dspark.yml up -d"

# --- 热保护：GPU 主频封顶（实测锁 2800 时 1M 上下文只到 75°C，不锁冲到 92-94°C 硬关机）---
GPU_CLOCK_MAX=2800
GPU_CLOCK_MIN=0

# --- 看门狗节律 ---
INTERVAL=30
PROBE_TIMEOUT=90              # DS4 1M 档负载重，1 token 探针也可能慢，给足
FAIL_LIMIT=3
BOOT_GRACE=1500              # 冷编译到 healthy 可达 15+ 分钟

LOG_DIR=/var/log/cluster-ops
